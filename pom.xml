<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>org.vinhhh.CiCdTest</groupId>
    <artifactId>DayTimeChecker-CiCd-Demo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
            WEB DEPENDENCY

            spring-boot-starter-web dùng để xây dựng web application.
            Nó hỗ trợ Controller, REST API, HTTP request/response và embedded Tomcat.

            Dùng cho:
            - API Testing với DateRestController
            - Web E2E Testing với DateController
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            THYMELEAF DEPENDENCY

            spring-boot-starter-thymeleaf dùng để render giao diện HTML.
            Trong project này nó dùng file index.html trong templates.

            Dùng cho:
            - Web UI
            - Web E2E Testing
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            UNIT TESTING DEPENDENCY

            spring-boot-starter-test chứa các thư viện test chính như:
            - JUnit 5
            - AssertJ
            - Mockito
            - Spring Test

            Dùng cho:
            - Unit Testing: DayTimeCheckerTest
            - Có thể dùng cho Controller test nếu cần

            Scope test nghĩa là dependency này chỉ dùng trong src/test/java.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            WEB E2E TESTING DEPENDENCY

            selenium-java dùng để tự động điều khiển trình duyệt.
            Trong project này Selenium mở Chrome, nhập form và kiểm tra kết quả UI.

            Dùng cho:
            - DateWebE2ETest

            Scope test nghĩa là Selenium chỉ dùng trong src/test/java,
            không dùng trong code chính của ứng dụng.
        -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.25.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <!-- Build runnable Spring Boot JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>